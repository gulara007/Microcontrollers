  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    lab7_loop();               /* frames from A and B, console commands, new readings */
  }
  /* USER CODE END 3 */
}

