/* USER CODE BEGIN Header */
/**
  ******************************************************************************
  * @file    main.c
  * @brief   Lab 5 (Task 5) - NUCLEO-F401RE: median of 20 RSSI readings
  *
  * Receives RSSI frames from ESP32-S3 Board B on USART1 (PA9 TX, PA10 RX,
  * 115200 8N1). After 20 valid readings it sorts them, takes the median
  * (mean of the 10th and 11th values) and prints one line on USART2
  * (ST-LINK virtual COM port, 115200):
  *
  *     d=4.0 m  n=20  med=-54.0
  *
  * The blue user button B1 steps the distance label through
  * 0.5, 1, 2, 4, 8 and 16 m and restarts the set of 20.
  *
  * Frame from Board B (4 bytes): 0xAA | LEN = 1 | RSSI (int8) | LEN XOR RSSI
  *
  * This file sets up its own clocks and pins for USART1, USART2, B1 and LD2,
  * so it works even if those peripherals were not enabled in CubeMX.
  * USART1 is read by polling, so no interrupt setup is needed.
  ******************************************************************************
  */
/* USER CODE END Header */
/* Includes ------------------------------------------------------------------*/
#include "main.h"

/* Private includes ----------------------------------------------------------*/
/* USER CODE BEGIN Includes */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
/* USER CODE END Includes */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define N_READINGS   20
#define FRAME_START  0xAA

#ifndef B1_Pin
#define B1_Pin        GPIO_PIN_13     /* blue user button  */
#define B1_GPIO_Port  GPIOC
#endif
#ifndef LD2_Pin
#define LD2_Pin       GPIO_PIN_5      /* green user LED    */
#define LD2_GPIO_Port GPIOA
#endif
/* USER CODE END PD */

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart1;   /* link to ESP32-S3 Board B          */
UART_HandleTypeDef huart2;   /* console via ST-LINK virtual COM   */

/* USER CODE BEGIN PV */
static int8_t  readings[N_READINGS];
static uint8_t count = 0;

static const int dist10[] = {5, 10, 20, 40, 80, 160};   /* distance x10, in m */
static const int N_DIST = sizeof(dist10) / sizeof(dist10[0]);
static int distIdx = 1;                                  /* start at 1.0 m     */

static uint8_t parseState = 0, frameLen = 0, frameData = 0;
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void Lab_Pins_Init(void);
static void MX_USART1_UART_Init(void);
static void MX_USART2_UART_Init(void);

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
static void consolePrint(const char *s)
{
  HAL_UART_Transmit(&huart2, (uint8_t *)s, (uint16_t)strlen(s), 100);
}

static void printDistance(void)
{
  char line[40];
  snprintf(line, sizeof(line), "--- d=%d.%d m ---\r\n",
           dist10[distIdx] / 10, dist10[distIdx] % 10);
  consolePrint(line);
}

/* Frame: 0xAA | LEN (=1) | DATA (RSSI, int8) | CHK (LEN ^ DATA) */
static void parseByte(uint8_t b)
{
  switch (parseState)
  {
    case 0:                                   /* wait for start byte */
      if (b == FRAME_START) parseState = 1;
      break;
    case 1:                                   /* length */
      frameLen = b;
      parseState = (frameLen == 1) ? 2 : 0;
      break;
    case 2:                                   /* RSSI */
      frameData = b;
      parseState = 3;
      break;
    case 3:                                   /* checksum */
      if (b == (uint8_t)(frameLen ^ frameData) && count < N_READINGS)
      {
        readings[count++] = (int8_t)frameData;
      }
      parseState = 0;
      break;
    default:
      parseState = 0;
      break;
  }
}

static int cmpInt8(const void *a, const void *b)
{
  return (int)(*(const int8_t *)a) - (int)(*(const int8_t *)b);
}

/* Read every byte waiting on USART1 (polling, no interrupt needed) */
static void pollUsart1(void)
{
  uint8_t b;
  if (__HAL_UART_GET_FLAG(&huart1, UART_FLAG_ORE))
  {
    __HAL_UART_CLEAR_OREFLAG(&huart1);        /* recover from overrun */
    parseState = 0;
  }
  while (HAL_UART_Receive(&huart1, &b, 1, 0) == HAL_OK)
  {
    parseByte(b);
  }
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  Lab_Pins_Init();          /* clocks + pins for USART1, USART2, B1, LD2 */
  MX_USART2_UART_Init();
  MX_USART1_UART_Init();

  /* USER CODE BEGIN 2 */
  consolePrint("\r\nLab 5 ready. B1 = next distance.\r\n");
  printDistance();
  /* USER CODE END 2 */

  /* Infinite loop */
  while (1)
  {
    /* USER CODE BEGIN 3 */
    pollUsart1();

    /* B1 (active low): next distance, restart the set of 20 */
    if (HAL_GPIO_ReadPin(B1_GPIO_Port, B1_Pin) == GPIO_PIN_RESET)
    {
      distIdx = (distIdx + 1) % N_DIST;
      count = 0;
      printDistance();
      HAL_Delay(50);
      while (HAL_GPIO_ReadPin(B1_GPIO_Port, B1_Pin) == GPIO_PIN_RESET) { }
      HAL_Delay(50);
      parseState = 0;
    }

    /* A full set of 20: sort, median, print */
    if (count >= N_READINGS)
    {
      int8_t s[N_READINGS];
      memcpy(s, readings, sizeof(s));
      count = 0;

      qsort(s, N_READINGS, sizeof(int8_t), cmpInt8);

      /* median of an even count = mean of the two middle values; kept x10 */
      int med10 = ((int)s[N_READINGS / 2 - 1] + (int)s[N_READINGS / 2]) * 5;

      char line[64];
      snprintf(line, sizeof(line), "d=%d.%d m  n=%d  med=%s%d.%d\r\n",
               dist10[distIdx] / 10, dist10[distIdx] % 10, N_READINGS,
               (med10 < 0) ? "-" : "", abs(med10) / 10, abs(med10) % 10);
      consolePrint(line);

      HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);   /* blink on each result */
    }
    /* USER CODE END 3 */
  }
}

/**
  * @brief Clocks and pins used by the lab (independent of CubeMX settings)
  *        PA2/PA3  = USART2 TX/RX (AF7) - console
  *        PA9/PA10 = USART1 TX/RX (AF7) - Board B
  *        PC13     = B1 input, PA5 = LD2 output
  */
static void Lab_Pins_Init(void)
{
  GPIO_InitTypeDef g = {0};

  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOC_CLK_ENABLE();
  __HAL_RCC_USART1_CLK_ENABLE();
  __HAL_RCC_USART2_CLK_ENABLE();

  g.Pin = GPIO_PIN_2 | GPIO_PIN_3;            /* USART2 */
  g.Mode = GPIO_MODE_AF_PP;
  g.Pull = GPIO_PULLUP;
  g.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
  g.Alternate = GPIO_AF7_USART2;
  HAL_GPIO_Init(GPIOA, &g);

  g.Pin = GPIO_PIN_9 | GPIO_PIN_10;           /* USART1 */
  g.Alternate = GPIO_AF7_USART1;
  HAL_GPIO_Init(GPIOA, &g);

  g.Pin = B1_Pin;                             /* button */
  g.Mode = GPIO_MODE_INPUT;
  g.Pull = GPIO_NOPULL;
  g.Alternate = 0;
  HAL_GPIO_Init(B1_GPIO_Port, &g);

  HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
  g.Pin = LD2_Pin;                            /* LED */
  g.Mode = GPIO_MODE_OUTPUT_PP;
  g.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(LD2_GPIO_Port, &g);
}

