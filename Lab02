/**
  * @brief  Simple blocking microsecond delay function for software PWM
  * @param  us: delay in microseconds
  */
void Delay_us(uint32_t us)
{
    // At 84 MHz, roughly 12-14 clock cycles per microsecond
    uint32_t count = us * 12;
    while(count--)
    {
        __NOP();
    }
}

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();

  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* ----------------------------------------------------------------------
     * 1. ACTIVE PHASE (100 ms duration)
     * Rapidly pulse PA5 with a 20% duty cycle (100 us HIGH, 400 us LOW)
     * to significantly reduce power consumption while keeping the sound active.
     * ---------------------------------------------------------------------- */
    for (uint16_t t = 0; t < 200; t++) // 200 cycles * 0.5 ms = 100 ms total
    {
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);
      Delay_us(100); // 20% ON time

      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET);
      Delay_us(400); // 80% OFF time
    }

    /* Ensure pin is driven completely LOW before entering Sleep */
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET);

    /* ----------------------------------------------------------------------
     * 2. SLEEP PHASE (900 ms duration)
     * Enter Low-Power Sleep Mode using WFI (Wait For Interrupt).
     * The SysTick interrupt wakes the MCU every 1 ms, so we loop 900 times.
     * ---------------------------------------------------------------------- */
    for (uint16_t i = 0; i < 900; i++)
    {
      HAL_PWR_EnterSLEEPMode(PWR_MAINREGULATOR_ON, PWR_SLEEPENTRY_WFI);
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

