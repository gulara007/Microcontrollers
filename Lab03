/**
 * Task 3A: TIM2 CH1 (PA5, D13) -> passive buzzer
 * Plays the first four notes of Beethoven's Fur Elise (E D# E D#),
 * then holds the last note and sweeps the duty cycle 10 -> 90 %.
 *
 * Board : NUCLEO-F401RE (84 MHz)
 * Timer : TIM2 on APB1, timer clock = 84 MHz (DS10086, Table 4)
 * PSC = 83 -> 1 MHz tick (1 us)      ARR = 1e6 / f - 1      duty = CCR / (ARR + 1)
 *
 * Replace Core/Src/main.c of a CubeMX project (NUCLEO-F401RE, TIM2 CH1 on PA5,
 * HAL_TIM_MspPostInit generated, project generated with peripheral init in main.c).
 */
/* USER CODE END Header */

#include "main.h"

/* USER CODE BEGIN Includes */
#include <stdint.h>
/* USER CODE END Includes */

TIM_HandleTypeDef htim2;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);

/* USER CODE BEGIN PV */
typedef struct {
    uint32_t arr;   /* ARR value, 0 = rest (silence) */
    uint16_t ms;    /* duration in milliseconds      */
} Note;

/* PSC = 83 -> ARR = round(1e6 / f) - 1 */
#define NOTE_E5   1516   /* 659.19 Hz  (E5  = 659.26 Hz) */
#define NOTE_DS5  1606   /* 622.28 Hz  (D#5 = 622.25 Hz) */
#define REST      0

/* Fur Elise, first four notes: mi  re#  mi  re# */
static const Note tune[] = {
    {NOTE_E5,  300},
    {NOTE_DS5, 300},
    {NOTE_E5,  300},
    {NOTE_DS5, 600},
    {REST,     800}
};
#define TUNE_LEN  (sizeof(tune) / sizeof(tune[0]))
/* USER CODE END PV */

/* USER CODE BEGIN 0 */
/* Set ARR and duty together; both are preloaded, so the change lands at the update event. */
static void set_note(uint32_t arr, uint32_t duty_percent)
{
    __HAL_TIM_SET_AUTORELOAD(&htim2, arr);
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, ((arr + 1) * duty_percent) / 100);
}

static void silence(void)
{
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0);      /* CCR = 0 -> pin stays low */
}

static void play_tune(void)
{
    for (uint32_t i = 0; i < TUNE_LEN; i++) {
        if (tune[i].arr == REST) {
            silence();
        } else {
            set_note(tune[i].arr, 50);
        }
        HAL_Delay(tune[i].ms);
    }
}

/* Hold the last note (D#5) and sweep duty 10 -> 90 %. Write your prediction down first. */
static void duty_sweep(void)
{
    for (uint32_t d = 10; d <= 90; d += 10) {
        set_note(NOTE_DS5, d);
        HAL_Delay(1500);
    }
    silence();
}
/* USER CODE END 0 */

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_TIM2_Init();

    /* USER CODE BEGIN 2 */
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);   /* starts the counter AND enables the output */
    /* USER CODE END 2 */

    while (1) {
        /* USER CODE BEGIN 3 */
        play_tune();
        HAL_Delay(1000);
        duty_sweep();
        HAL_Delay(3000);
        /* USER CODE END 3 */
    }
}

